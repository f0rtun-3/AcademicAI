# Secrets and deployment settings. Copy to .env and fill in.
#
# Set this to "production" in a real deployment. The app then REFUSES to start
# with a default secret key, an in-memory database, or the test email backend.
ACADEMICAI_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACADEMICAI_SECRET_KEY=change-me

# Point this at a PERSISTENT volume. An ephemeral filesystem loses the database.
ACADEMICAI_DB_PATH=/var/lib/academicai/academicai.db
ACADEMICAI_SQLITE_WAL=true
ACADEMICAI_BUSY_TIMEOUT_MS=5000
ACADEMICAI_BACKUP_DIR=/var/lib/academicai/backups

# MVP SCOPE: student ID-card verification has been REMOVED from the product.
# There is no identity provider, no vision/OCR provider, no fixture and no
# Tesseract path to configure - none of that code exists any more. The account
# gate is email verification against the approved institutional-domain
# registry, which is database state seeded from db/reference_data.py.
ACADEMICAI_MAX_CONTENT_LENGTH=8388608

# AI provider: "heuristic" (deterministic, no API key) or "anthropic".
ACADEMICAI_AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ACADEMICAI_ANTHROPIC_MODEL=claude-opus-5

# ── EMAIL DELIVERY ─────────────────────────────────────────────────────────
#
#   memory   records messages in-process. Tests only.
#   console  prints them. Development: read the verification code from the log.
#   resend   actually sends, via https://resend.com
#
# Only `resend` puts mail on the wire. The other two are recorded as SIMULATED
# rather than SENT, so the outbox never claims a delivery nobody made, and a
# production start is REFUSED unless a delivering backend is configured.
ACADEMICAI_EMAIL_BACKEND=console

# From resend.com -> API Keys. SECRET: keep it in .env, never in git.
ACADEMICAI_RESEND_API_KEY=

# QUOTE this one: scripts/dev.sh sources this file, and an unquoted "<"
# would be read by the shell as a redirect.
# The From address. Until you verify your own domain in Resend, the only
# usable value is their shared sender, and it can then only deliver to the
# address your Resend account is registered with - enough to test the flow,
# not enough to mail students. To mail anyone, add your domain in Resend,
# publish the DNS records it gives you, and change this to that domain.
ACADEMICAI_EMAIL_FROM="AcademicAI <onboarding@resend.dev>"

# Seconds to wait on the provider before giving up.
ACADEMICAI_EMAIL_TIMEOUT=15

# ── EMAIL VERIFICATION CODE ────────────────────────────────────────────────
#
# Six digits is only a million possibilities, so all three of these are what
# make it safe. Raising any one of them weakens the others.
ACADEMICAI_OTP_TTL_MINUTES=10
ACADEMICAI_OTP_MAX_ATTEMPTS=5
ACADEMICAI_OTP_RESEND_COOLDOWN_SECONDS=60

# Worker poll interval, seconds.
ACADEMICAI_WORKER_INTERVAL=60

# Policy values. Defaults match the product rules; change deliberately.
ACADEMICAI_BALLOT_HOURS=24
ACADEMICAI_BALLOT_MIN_VOTES=3
ACADEMICAI_MAX_REPS=3
ACADEMICAI_MIN_ELECTORATE=3
ACADEMICAI_CANDIDATE_COOLDOWN_DAYS=7
ACADEMICAI_REMOVAL_COOLDOWN_DAYS=7
# Official reminders fire at REMINDER_HOUR o'clock on the academic day
# REMINDER_LEAD_DAYS before the event, on the UNIVERSITY'S clock
# (universities.timezone, e.g. Africa/Lagos) - not server time and not UTC.
# 8 means 08:00 in the university's own timezone.
ACADEMICAI_REMINDER_LEAD_DAYS=1
ACADEMICAI_REMINDER_HOUR=8

# The institutional email-domain registry is database state, seeded from
# backend/academicai/db/reference_data.py on first start. There is no
# environment variable that widens it: adding a university means adding a
# registry row, never relaxing the matching rule.

# ── TLS TRUST STORE ────────────────────────────────────────────────────────
# Only needed if HTTPS calls to the email provider fail with
# "CERTIFICATE_VERIFY_FAILED". A python.org build on macOS ships without root
# certificates; either run "Install Certificates.command" from the Python
# folder in /Applications, or point this at a certificate bundle:
# SSL_CERT_FILE=/etc/ssl/cert.pem

# ── EMAIL VERIFICATION: ON OR OFF ──────────────────────────────────────────
#
# true (default) = the real product: register -> six-digit code by email ->
#                  verify -> access.
# false          = accounts are created already marked verified. No code is
#                  generated, no email is sent, and the verification screen is
#                  never shown.
#
# WHAT false COSTS: proof that the person registering can read mail at the
# address they typed. Anyone who knows the shape of a valid student address can
# register as anyone. NOTHING else is relaxed - the institutional-domain rule,
# duplicate detection, password hashing and every authorisation check are
# unchanged, and the OTP implementation is untouched and ready to switch back.
#
# Accounts created this way are recorded in users.email_verification_method as
# SKIPPED_NO_VERIFICATION, so they can be found again later:
#   SELECT email FROM users WHERE email_verification_method = 'SKIPPED_NO_VERIFICATION';
ACADEMICAI_EMAIL_VERIFICATION_REQUIRED=true

# Required to run with verification off in ENV=production, and useless for
# anything else. Two variables rather than one, because a single flag can be
# set and forgotten; a second one whose only meaning is "yes, this deployment
# does not verify email ownership" cannot be arrived at by accident.
ACADEMICAI_DEPLOYMENT_MODE=standard
